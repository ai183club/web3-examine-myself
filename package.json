{
  "name": "web3-examine-myself",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:simulated": "hardhat ignition deploy ignition/modules/DailyCheckIn.ts --network hardhatMainnet",
    "deploy:local": "hardhat ignition deploy ignition/modules/DailyCheckIn.ts --network localhost",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/DailyCheckIn.ts --network sepolia",
    "sync:frontend": "hardhat run scripts/sync-frontend.ts",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:preview": "pnpm --dir frontend preview",
    "build": "pnpm compile && pnpm sync:frontend && pnpm frontend:build",
    "check": "pnpm compile && pnpm test && pnpm sync:frontend && pnpm frontend:build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.1",
    "hardhat": "^3.12.0",
    "typescript": "~6.0.3",
    "viem": "^2.55.10"
  }
}
